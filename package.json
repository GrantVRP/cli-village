{
  "name": "cli-village",
  "version": "0.1.0",
  "description": "Watch your agents work in a tiny low-poly village. A friendly wrapper around the Infisical CLI.",
  "license": "MIT",
  "author": "GrantVRP",
  "type": "module",
  "bin": {
    "cli-village": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-preload.mjs && vite build --config web/vite.config.ts --logLevel warn && vite build --config app/vite.config.ts --logLevel warn",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p app/tsconfig.json",
    "app": "node dist/cli.js app --demo",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "demo": "node dist/cli.js --demo",
    "build:web": "vite build --config web/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "village": "node dist/cli.js open --demo",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec --test-timeout=120000 --test-force-exit \"test/*.test.mjs\"",
    "test:app": "npm run build && node --test --test-reporter=spec --test-timeout=480000 --test-force-exit \"test/app/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrantVRP/cli-village.git"
  },
  "keywords": [
    "infisical",
    "secrets",
    "cli",
    "agents",
    "threejs",
    "village"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
