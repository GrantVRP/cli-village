{
  "name": "cli-village",
  "version": "0.1.0",
  "description": "Watch your agents work in a tiny low-poly village. A friendly wrapper around the Infisical CLI.",
  "license": "MIT",
  "author": "GrantVRP",
  "type": "module",
  "bin": {
    "cli-village": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrantVRP/cli-village.git"
  },
  "keywords": [
    "infisical",
    "secrets",
    "cli",
    "agents",
    "threejs",
    "village"
  ],
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
