{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "../web/src/connection.ts", "../web/src/lists.ts", "../src/events/state.ts", "../src/events/store.ts", "../src/events/types.ts", "../src/views/colors.ts", "../src/events/explain.ts"]
}
