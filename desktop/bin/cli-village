#!/bin/sh
# CLI Village's own cli-village command, for the desktop app's terminal (like VS Code's
# `code`). The app sets CLI_VILLAGE_ELECTRON and CLI_VILLAGE_CLI in that terminal;
# ELECTRON_RUN_AS_NODE makes the app's Electron run the command line as plain Node.js.
if [ -z "$CLI_VILLAGE_ELECTRON" ]; then
  echo "This cli-village works only in the CLI Village app's terminal. Elsewhere: npm install -g cli-village" >&2
  exit 1
fi
ELECTRON_RUN_AS_NODE=1 exec "$CLI_VILLAGE_ELECTRON" "$CLI_VILLAGE_CLI" "$@"
